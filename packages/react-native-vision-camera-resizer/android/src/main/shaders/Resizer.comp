#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;

// 0u == DataType::INT8, 1u == DataType::UINT8, 2u == DataType::FLOAT16, 3u == DataType::FLOAT32
layout(constant_id = 0) const uint kDataType = 0u;
// 0u == ChannelOrder::RGB, 1u == ChannelOrder::BGR
layout(constant_id = 1) const uint kChannelOrder = 0u;
// 0u == PixelLayout::INTERLEAVED == HWC / NHWC, 1u == PixelLayout::PLANAR == CHW / NCHW
layout(constant_id = 2) const uint kPixelLayout = 0u;
// Number of channels per pixel. e.g. for RGB/BGR, this is 3u.
layout(constant_id = 3) const uint kChannelCount = 0u;
// 0u == ScaleMode::COVER, 1u == ScaleMode::CONTAIN, 2u == ScaleMode::STRETCH
layout(constant_id = 4) const uint kScaleMode = 0u;
// 0u == DownscaleFilter::BILINEAR, 1u == DownscaleFilter::AREA
layout(constant_id = 5) const uint kDownscaleFilter = 0u;

// The output buffer is addressed as 32-bit words. It must be pre-zeroed before dispatch
// so that sub-word atomicOr writes from adjacent pixels combine correctly.
layout(set = 0, binding = 1, std430) buffer OutputBuffer {
  uint outputWords[];
};

layout(push_constant) uniform PushConstants {
  uint outputWidth;
  uint outputHeight;
  int rotationDegrees;
  uint isMirrored; // 0u == false, 1u == true
} pushConstants;

// Write a packed value (up to 32 bits wide) starting at the given byte offset.
// The output buffer must be pre-zeroed so atomicOr produces correct results.
void writePacked(uint byteOffset, uint bitWidth, uint packed) {
  uint wordIndex = byteOffset >> 2u;
  uint bitShift = (byteOffset & 3u) * 8u;

  if (bitShift == 0u && bitWidth == 32u) {
    // Word-aligned full-word write: no other thread touches this word.
    outputWords[wordIndex] = packed;
  } else if (bitShift + bitWidth <= 32u) {
    // Fits within a single word.
    atomicOr(outputWords[wordIndex], packed << bitShift);
  } else {
    // Straddles two words.
    atomicOr(outputWords[wordIndex], packed << bitShift);
    atomicOr(outputWords[wordIndex + 1u], packed >> (32u - bitShift));
  }
}

// Map a point of the output (in output pixels) back into source texture space after mirroring and
// undoing the frame rotation.
vec2 outputToInputCoordinate(vec2 outputPosition) {
  vec2 outputSize = vec2(float(pushConstants.outputWidth), float(pushConstants.outputHeight));
  vec2 sourceSize = vec2(textureSize(inputImage, 0));
  vec2 outputCoordinate = outputPosition / outputSize;

  int normalizedRotation = pushConstants.rotationDegrees % 360;
  if (normalizedRotation < 0) {
    normalizedRotation += 360;
  }

  // Scale modes fit the upright content into the output. For buffers that
  // need a 90°/270° rotation, the upright dimensions are swapped.
  bool isSideways = normalizedRotation == 90 || normalizedRotation == 270;
  if (isSideways) {
    sourceSize = sourceSize.yx;
  }

  vec2 coordinate;
  switch (kScaleMode) {
    case 0u: { // 0u == ScaleMode::COVER
      float scale = max(outputSize.x / sourceSize.x, outputSize.y / sourceSize.y);
      vec2 renderedSourceSizeInOutput = sourceSize * scale;
      vec2 renderedSourceOffsetInOutput = (outputSize - renderedSourceSizeInOutput) * 0.5;
      coordinate = ((outputCoordinate * outputSize) - renderedSourceOffsetInOutput) / renderedSourceSizeInOutput;
      break;
    }
    case 1u: { // 1u == ScaleMode::CONTAIN
      float scale = min(outputSize.x / sourceSize.x, outputSize.y / sourceSize.y);
      vec2 renderedSourceSizeInOutput = sourceSize * scale;
      vec2 renderedSourceOffsetInOutput = (outputSize - renderedSourceSizeInOutput) * 0.5;
      coordinate = ((outputCoordinate * outputSize) - renderedSourceOffsetInOutput) / renderedSourceSizeInOutput;
      // Contain mode pads outside the rendered source with black bars.
      bool isOutsideSource = coordinate.x < 0.0 || coordinate.x > 1.0 || coordinate.y < 0.0 || coordinate.y > 1.0;
      if (isOutsideSource) {
        return vec2(-1.0);
      }
      break;
    }
    case 2u: { // 2u == ScaleMode::STRETCH
      // Independent per-axis stretching: the entire source [0,1]^2 maps to the
      // entire output [0,1]^2. Aspect ratio is NOT preserved.
      coordinate = outputCoordinate;
      break;
    }
    default:
      // Unsupported ScaleMode specialization. Force out-of-bounds so the caller gets black.
      return vec2(-1.0);
  }

  // Map output -> input by undoing rotation before undoing mirroring.
  // Mirroring is relative to the already-rotated, upright presentation.
  int inverseRotation = (360 - normalizedRotation) % 360;

  switch (inverseRotation) {
    case 90:
      coordinate = vec2(1.0 - coordinate.y, coordinate.x);
      break;
    case 180:
      coordinate = vec2(1.0 - coordinate.x, 1.0 - coordinate.y);
      break;
    case 270:
      coordinate = vec2(coordinate.y, 1.0 - coordinate.x);
      break;
    default:
      break;
  }

  if (pushConstants.isMirrored == 1u) {
    coordinate.x = 1.0 - coordinate.x;
  }

  return coordinate;
}

vec3 orderedColor(vec3 rgb) {
  switch (kChannelOrder) {
    case 0u: // 0u == ChannelOrder::RGB
      return rgb;
    case 1u: // 1u == ChannelOrder::BGR
      return rgb.bgr;
    default:
      // Unsupported ChannelOrder ordinal. Fall back to black so broken channel orders fail visibly at runtime.
      return vec3(0.0);
  }
}

uint quantizeUInt8(float value) {
  return uint(clamp(roundEven(value * 255.0), 0.0, 255.0));
}

uint quantizeInt8(float value) {
  int quantized = int(roundEven(value * 255.0)) - 128;
  return uint(quantized & 0xFF);
}

void write8BitColor(uvec2 gid, uint packed) {
  uint pixelIndex = (gid.y * pushConstants.outputWidth) + gid.x;
  uint pixelCount = pushConstants.outputWidth * pushConstants.outputHeight;

  switch (kPixelLayout) {
    case 0u: // 0u == PixelLayout::INTERLEAVED == HWC / NHWC
      // Interleaved: all channel bytes are consecutive.
      writePacked(pixelIndex * kChannelCount, kChannelCount * 8u, packed);
      return;
    case 1u: // 1u == PixelLayout::PLANAR == CHW / NCHW
      // Planar: each channel byte is in a separate plane.
      for (uint c = 0u; c < kChannelCount; c++) {
        writePacked((c * pixelCount) + pixelIndex, 8u, (packed >> (c * 8u)) & 0xFFu);
      }
      return;
    default:
      // Unsupported PixelLayout specialization. Return without writing so broken layouts stay visibly wrong.
      return;
  }
}

void writeFloat16Color(uvec2 gid, vec3 ordered) {
  uint pixelIndex = (gid.y * pushConstants.outputWidth) + gid.x;
  uint pixelCount = pushConstants.outputWidth * pushConstants.outputHeight;

  switch (kPixelLayout) {
    case 0u: { // 0u == PixelLayout::INTERLEAVED == HWC / NHWC
      // Interleaved: write channel halfs in pairs (two halfs fill one 32-bit word).
      uint byteOffset = pixelIndex * kChannelCount * 2u;
      for (uint c = 0u; c < kChannelCount; c += 2u) {
        uint h0 = packHalf2x16(vec2(ordered[c], 0.0)) & 0xFFFFu;
        if (c + 1u < kChannelCount) {
          uint h1 = packHalf2x16(vec2(ordered[c + 1u], 0.0)) & 0xFFFFu;
          writePacked(byteOffset + c * 2u, 32u, h0 | (h1 << 16u));
        } else {
          writePacked(byteOffset + c * 2u, 16u, h0);
        }
      }
      return;
    }
    case 1u: // 1u == PixelLayout::PLANAR == CHW / NCHW
      // Planar: each channel half is in a separate plane.
      for (uint c = 0u; c < kChannelCount; c++) {
        uint halfBits = packHalf2x16(vec2(ordered[c], 0.0)) & 0xFFFFu;
        writePacked(((c * pixelCount) + pixelIndex) * 2u, 16u, halfBits);
      }
      return;
    default:
      // Unsupported PixelLayout specialization. Return without writing so broken layouts stay visibly wrong.
      return;
  }
}

void writeFloat32Color(uvec2 gid, vec3 ordered) {
  uint pixelIndex = (gid.y * pushConstants.outputWidth) + gid.x;
  uint pixelCount = pushConstants.outputWidth * pushConstants.outputHeight;

  switch (kPixelLayout) {
    case 0u: // 0u == PixelLayout::INTERLEAVED == HWC / NHWC
      // Interleaved
      for (uint c = 0u; c < kChannelCount; c++) {
        outputWords[(pixelIndex * kChannelCount) + c] = floatBitsToUint(ordered[c]);
      }
      return;
    case 1u: // 1u == PixelLayout::PLANAR == CHW / NCHW
      // Planar
      for (uint c = 0u; c < kChannelCount; c++) {
        outputWords[(c * pixelCount) + pixelIndex] = floatBitsToUint(ordered[c]);
      }
      return;
    default:
      // Unsupported PixelLayout specialization. Return without writing so broken layouts stay visibly wrong.
      return;
  }
}

void writeOutputColor(uvec2 gid, vec3 ordered) {
  switch (kDataType) {
    case 0u: { // 0u == DataType::INT8
      // Pack all signed channel bytes into a single value.
      uint packed = 0u;
      for (uint c = 0u; c < kChannelCount; c++) {
        packed |= quantizeInt8(ordered[c]) << (c * 8u);
      }
      write8BitColor(gid, packed);
      return;
    }
    case 1u: { // 1u == DataType::UINT8
      // Pack all unsigned channel bytes into a single value.
      uint packed = 0u;
      for (uint c = 0u; c < kChannelCount; c++) {
        packed |= quantizeUInt8(ordered[c]) << (c * 8u);
      }
      write8BitColor(gid, packed);
      return;
    }
    case 2u: // 2u == DataType::FLOAT16
      writeFloat16Color(gid, ordered);
      return;
    case 3u: // 3u == DataType::FLOAT32
      writeFloat32Color(gid, ordered);
      return;
    default:
      // Unsupported DataType specialization. Return without writing so the valid path stays simple.
      return;
  }
}

void main() {
  uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= pushConstants.outputWidth || gid.y >= pushConstants.outputHeight) {
    return;
  }

  if (kDownscaleFilter != 1u) {
    vec2 inputCoordinate = outputToInputCoordinate(vec2(gid) + vec2(0.5));
    if (inputCoordinate.x < 0.0 || inputCoordinate.y < 0.0) {
      writeOutputColor(gid, orderedColor(vec3(0.0)));
      return;
    }

    vec3 rgb = clamp(texture(inputImage, inputCoordinate).rgb, 0.0, 1.0);
    vec3 ordered = orderedColor(rgb);
    writeOutputColor(gid, ordered);
    return;
  }

  // DownscaleFilter::AREA (OpenCV's INTER_AREA): take enough evenly spaced bilinear samples that
  // neighbouring samples are at most one source pixel apart and average them. At exactly 2x every
  // sample lands on a source pixel center (a true box filter); an upscale keeps the single sample.
  vec2 outputSize = vec2(float(pushConstants.outputWidth), float(pushConstants.outputHeight));
  vec2 sourceSize = vec2(textureSize(inputImage, 0));
  int normalizedRotation = pushConstants.rotationDegrees % 360;
  if (normalizedRotation < 0) {
    normalizedRotation += 360;
  }
  if (normalizedRotation == 90 || normalizedRotation == 270) {
    sourceSize = sourceSize.yx;
  }
  vec2 sourcePixelsPerOutputPixel;
  switch (kScaleMode) {
    case 0u: // 0u == ScaleMode::COVER
      sourcePixelsPerOutputPixel = vec2(1.0 / max(outputSize.x / sourceSize.x, outputSize.y / sourceSize.y));
      break;
    case 1u: // 1u == ScaleMode::CONTAIN
      sourcePixelsPerOutputPixel = vec2(1.0 / min(outputSize.x / sourceSize.x, outputSize.y / sourceSize.y));
      break;
    default: // 2u == ScaleMode::STRETCH
      sourcePixelsPerOutputPixel = sourceSize / outputSize;
      break;
  }
  // The epsilon keeps an exact integer ratio from rounding up to an extra sample.
  uvec2 taps = uvec2(clamp(ceil(sourcePixelsPerOutputPixel - vec2(0.001)), vec2(1.0), vec2(8.0)));

  vec3 sum = vec3(0.0);
  for (uint j = 0u; j < taps.y; j++) {
    for (uint i = 0u; i < taps.x; i++) {
      vec2 offset = (vec2(float(i), float(j)) + vec2(0.5)) / vec2(taps);
      vec2 inputCoordinate = outputToInputCoordinate(vec2(gid) + offset);
      // Contain mode's bars (and unsupported scale modes) contribute black.
      if (inputCoordinate.x >= 0.0 && inputCoordinate.y >= 0.0) {
        sum += clamp(texture(inputImage, inputCoordinate).rgb, 0.0, 1.0);
      }
    }
  }
  writeOutputColor(gid, orderedColor(sum / float(taps.x * taps.y)));
}
